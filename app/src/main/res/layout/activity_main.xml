<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/top_bar_main" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Status: shown once enrolled. -->
            <LinearLayout
                android:id="@+id/status_card"
                style="@style/Card"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:id="@+id/status_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/icon_circle"
                        android:importantForAccessibility="no"
                        android:padding="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/status_title"
                            style="@style/Text.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/status_text"
                            style="@style/Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/busy"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/message"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/message"
                    android:padding="12dp"
                    android:textColor="@color/on_surface"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/status_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/check_now"
                        style="@style/Button.Filled"
                        android:text="@string/check_now" />

                    <Button
                        android:id="@+id/renew_now"
                        style="@style/Button.Outlined"
                        android:layout_marginStart="8dp"
                        android:text="@string/renew_now" />
                </LinearLayout>
            </LinearLayout>

            <!-- Things the user should do, one card each. -->
            <LinearLayout
                android:id="@+id/tasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Setup: shown when not enrolled or when a new link is needed. -->
            <LinearLayout
                android:id="@+id/setup_card"
                style="@style/Card">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/icon_circle"
                    android:backgroundTint="@color/primary_container"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_wifi_key"
                    android:tint="@color/on_primary_container" />

                <TextView
                    android:id="@+id/setup_title"
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/setup_title"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/setup_text"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/setup_text" />

                <EditText
                    android:id="@+id/setup_link"
                    style="@style/Field"
                    android:layout_marginTop="20dp"
                    android:hint="@string/setup_link_hint"
                    android:imeOptions="actionDone|flagNoPersonalizedLearning"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:saveEnabled="false" />

                <Button
                    android:id="@+id/paste_link"
                    style="@style/Button.Outlined"
                    android:layout_marginTop="12dp"
                    android:text="@string/paste_link" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wpa3_only"
                            android:textIsSelectable="false" />

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wpa3_only_help"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/setup_wpa3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/wpa3_only" />
                </LinearLayout>

                <Button
                    android:id="@+id/set_up"
                    style="@style/Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_marginTop="20dp"
                    android:text="@string/set_up" />

                <Button
                    android:id="@+id/manual_link"
                    style="@style/Button.Text"
                    android:layout_width="match_parent"
                    android:layout_marginTop="4dp"
                    android:text="@string/manual_link" />
            </LinearLayout>

            <!-- Details: shown once enrolled. -->
            <LinearLayout
                android:id="@+id/details_card"
                style="@style/Card">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/details" />

                <LinearLayout
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
